{
  "name": "levelflow-cloud",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24",
    "npm": ">=11"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "check": "tsc -b --noEmit",
    "check:bundle": "node scripts/check-bundle-budget.mjs",
    "check:migrations": "node scripts/check-migrations.mjs",
    "test": "tsx --test tests/**/*.test.ts",
    "test:e2e": "env -u NO_COLOR playwright test"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.108.2",
    "lightweight-charts": "^5.0.9",
    "lucide-react": "^0.511.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@types/node": "^25.9.5",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^6.0.3",
    "autoprefixer": "^10.5.4",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.23.1",
    "typescript": "^6.0.3",
    "vite": "^8.1.5"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "fsevents@2.3.2": true,
    "fsevents@2.3.3": true
  }
}
