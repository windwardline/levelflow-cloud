# Windward Capital LevelFlow Cloud environment template.
# Copy to .env.local for the web app and .env for the server process.

# Public web client. These values are safe to expose in browser bundles.
VITE_APP_URL=http://localhost:5173
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_publishable_key
VITE_ENABLE_GOOGLE_AUTH=false
VITE_ENABLE_APPLE_AUTH=false
VITE_ENVIRONMENT=local

# Express server.
PORT=8080
NODE_ENV=development
APP_URL=http://localhost:5173
CORS_ORIGIN=http://localhost:5173

# Server-only Supabase credentials. Never expose service-role keys to the browser.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
SUPABASE_JWT_SECRET=your_jwt_secret_for_server_side_verification_only

# Market data and macroeconomic calendar providers.
MASSIVE_API_BASE_URL=https://api.massive.com
MASSIVE_API_KEY=your_massive_api_key
ECONOMIC_CALENDAR_PROVIDER=fmp
FMP_API_KEY=your_financial_modeling_prep_key
FINNHUB_API_KEY=your_finnhub_key

# E8 server-time automation. Europe/Prague observes CET/CEST.
E8_SERVER_TIMEZONE=Europe/Prague
DAILY_DRAWDOWN_RESET_CRON=0 0 * * *
SIGNATURE_AUTO_CLOSURE_CRON=45 22 * * *
WEEKEND_PENDING_CLEAR_CRON=0 22 * * 5
SPREAD_PROTECTION_SCAN_CRON=*/5 * * * *
OUTCOME_REVIEW_CRON=0 * * * *

# Risk guardrails.
DEFAULT_MAX_CORRELATED_SETUPS=1
NEWS_BLACKOUT_MINUTES_BEFORE=5
NEWS_BLACKOUT_MINUTES_AFTER=5
E8_PRO_DAILY_PROFIT_CAP_BUFFER_PCT=1.85
